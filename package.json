{
  "name": "paradox-webmcp",
  "version": "0.1.0",
  "description": "Semantic instrumentation and bounded correctness testing for stateful WebMCP applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joe-Simo/paradox-webmcp.git"
  },
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "./dist/sdk/index.js",
  "types": "./dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "files": [
    "dist/sdk",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:sdk": "tsup sdk/index.ts --format esm --dts --out-dir dist/sdk --clean --tsconfig tsconfig.sdk.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "fast-json-stable-stringify": "^2.1.0",
    "geist": "^1.5.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "vgpu": "^0.3.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.0",
    "fast-check": "^4.3.0",
    "jsdom": "^27.2.0",
    "tailwindcss": "^4.1.17",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.0.8"
  }
}
